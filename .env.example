# AmenDesk Environment Configuration Template
# Copy this file to .env.local and populate the secrets.

# Resend API Key for Amen Mart official email communications
RESEND_API_KEY=re_your_api_key_here

# Default Resend From Email (e.g. Amen Mart <notifications@yourdomain.com>)
RESEND_FROM_EMAIL=Amen Mart <notifications@yourdomain.com>
